<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug builds only, so the QC harness can serve a fixture feed on localhost. Release does not merge this. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- The release service is not exported. The harness starts it the same way the alarm does, after am kill. -->
        <service
            android:name=".watch.ScoreWatchService"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
