# football-data.org token (https://www.football-data.org/client/register).
# Leave blank to run the simulated matchday. The key stays on the server.
FOOTBALL_DATA_API_KEY=

# demo | live
# live is used only when FOOTBALL_DATA_API_KEY is set.
# demo forces simulated scores even if a key is present.
DATA_MODE=demo

# Local API port. Render injects PORT; do not set that in production.
PORT=8787
